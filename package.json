{
  "name": "md-convertor",
  "productName": "MD-Convertor",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3210",
    "dev:electron": "wait-on http-get://127.0.0.1:3210 && ELECTRON_RENDERER_URL=http://127.0.0.1:3210 electron .",
    "dev:desktop": "concurrently --kill-others --success first npm:dev:web npm:dev:electron",
    "build": "next build",
    "desktop:prepare": "install-electron && node scripts/prepare-desktop.mjs",
    "desktop:package": "npm run build && npm run desktop:prepare && electron-forge package --platform=darwin --arch=arm64",
    "desktop:make": "npm run build && npm run desktop:prepare && electron-forge make --platform=darwin --arch=arm64",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "e2e:server": "node scripts/start-e2e-server.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "desktop:release": "node scripts/release-desktop.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.13",
    "ipaddr.js": "^2.4.0",
    "jsdom": "^27.0.1",
    "next": "^16.3.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.3",
    "electron": "^43.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.10"
  }
}
